{
  "governs": [
    "packages/*/src/**",
    "packages/*/package.json",
    "packages/*/eslint.config.js",
    "packages/*/tsconfig*.json",
    "extensions/*/src/**",
    "extensions/*/package.json",
    "extensions/*/sheavly.json",
    "extensions/*/eslint.config.js",
    "extensions/*/tsconfig*.json",
    "apps/*/src/**",
    "apps/*/package.json",
    "apps/*/eslint.config.js",
    "apps/*/tsconfig*.json",
    "eslint.config.js",
    "knip.json",
    "turbo.json",
    "tsconfig*.json",
    "vitest.config.ts",
    "docs/**",
    "packages/*/README.md",
    "packages/*/docs/**",
    "extensions/*/README.md",
    "extensions/*/docs/**",
    "apps/*/README.md",
    "apps/*/docs/**"
  ],
  "guides": {
    "layers.md": [
      "packages/*/src/**",
      "extensions/*/src/**",
      "apps/*/src/**",
      "packages/*/package.json",
      "extensions/*/package.json",
      "apps/*/package.json"
    ],
    "file-kinds.md": ["packages/*/src/**", "extensions/*/src/**", "apps/*/src/**"],
    "extensions.md": [
      "extensions/*/src/**",
      "extensions/*/sheavly.json",
      "packages/extension/src/**"
    ],
    "extending.md": [
      "packages/tools/src/**",
      "extensions/coding/src/**",
      "packages/providers/src/**",
      "packages/loop/src/**",
      "packages/core/src/hook/**",
      "packages/protocol/src/event/**",
      "packages/protocol/src/api/**",
      "apps/backend/src/api/**"
    ],
    "principles.md": [
      "packages/eslint-config/**",
      "packages/*/src/**",
      "extensions/*/src/**",
      "apps/*/src/**"
    ],
    "packages.md": [
      "packages/*/package.json",
      "packages/*/README.md",
      "packages/*/docs/**",
      "extensions/*/package.json",
      "extensions/*/README.md",
      "extensions/*/docs/**",
      "apps/*/package.json",
      "apps/*/README.md",
      "apps/*/docs/**",
      "docs/**"
    ],
    "tests.md": [
      "packages/*/src/**/__tests__/**",
      "extensions/*/src/**/__tests__/**",
      "apps/*/src/**/__tests__/**",
      "packages/*/src/testing/**",
      "extensions/*/src/testing/**",
      "apps/*/src/testing/**"
    ],
    "quality-gate.md": [
      ".cursor/hooks/**",
      "scripts/**",
      "eslint.config.js",
      "knip.json",
      "turbo.json"
    ],
    "debugging.md": [
      "packages/storage/src/**",
      "apps/backend/src/**",
      "apps/terminal/src/workbook/**"
    ],
    "logging.md": [
      "packages/logger/**",
      "apps/backend/src/logging/**",
      "packages/storage/src/server-log/**",
      "packages/storage/src/conversation-store/conversation-log*",
      "packages/eslint-config/src/rules/log-*",
      "packages/eslint-config/src/rules/no-log*",
      "packages/eslint-config/src/rules/no-failure-output-in-catch.js"
    ],
    "state-machines.md": [
      "packages/loop/src/**",
      "packages/runtime/src/**",
      "packages/process/src/**",
      "packages/host/src/**",
      "packages/tools/src/sub-agent/**",
      "packages/tools/src/tasks/**",
      "extensions/coding/src/run-command/**",
      "extensions/coding/src/trust/**",
      "apps/terminal/src/interrupt/**",
      "apps/terminal/src/client/**"
    ],
    "sessions-and-background-work.md": [
      "packages/runtime/src/tasks/**",
      "packages/tools/src/sub-agent/**",
      "packages/tools/src/tasks/**",
      "extensions/coding/src/run-command/**"
    ]
  },
  "nudge": ["extending.md", "state-machines.md"],
  "lintRules": [
    "harness/imports",
    "harness/layout",
    "harness/extension-definition",
    "harness/extension-options-use-services",
    "harness/extension-no-runtime-registries",
    "harness/extension-public-contract",
    "harness/extension-declares-grants",
    "harness/file-kind",
    "harness/kind-contents",
    "harness/single-definition",
    "harness/no-terminal-io",
    "harness/no-direct-clock",
    "harness/no-raw-error",
    "harness/no-silent-catch",
    "harness/no-handwritten-notice",
    "harness/prompt-location",
    "harness/branded-ids",
    "harness/guard-env-read",
    "harness/guard-env-write",
    "harness/guard-file-tool-resolve",
    "harness/guard-search-root",
    "harness/guard-working-root",
    "harness/no-adhoc-command-deadline",
    "harness/no-adhoc-chat-state",
    "harness/no-adhoc-ctrl-c",
    "harness/no-adhoc-latest-request",
    "harness/no-adhoc-main-session",
    "harness/no-adhoc-notice-entry",
    "harness/no-adhoc-task-kind",
    "harness/no-adhoc-unknown-approval",
    "harness/no-barrel",
    "harness/no-brand-cast",
    "harness/no-credentials-file",
    "harness/no-default-export",
    "harness/no-direct-file-writes",
    "harness/no-direct-instruction-context",
    "harness/no-discovery-path",
    "harness/no-direct-task-start",
    "harness/no-dotdot-prefix",
    "harness/no-handrolled-model-send",
    "harness/no-handrolled-provider-policy",
    "harness/no-handrolled-reply-reader",
    "harness/no-key-holder-import",
    "harness/log-error-as-value",
    "harness/log-event-name",
    "harness/no-failure-output-in-catch",
    "harness/no-log-and-throw",
    "harness/no-logger-in-pure-kind",
    "harness/no-process-env",
    "harness/no-raw-fs-in-instruction-source",
    "harness/no-raw-model-fetch",
    "harness/no-raw-serial-queue",
    "harness/no-unescaped-model-text",
    "harness/params-object",
    "harness/permission-store-root",
    "harness/pure-imports",
    "harness/server-through-finder",
    "harness/system-prompt-review"
  ],
  "ruleFiles": {
