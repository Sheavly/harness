{
  "name": "@sheavly/harness",
  "version": "1.0.0",
  "scripts": {
    "test": "turbo run test test:root",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:watch": "vitest --mode all",
    "lint": "turbo run lint lint:root",
    "lint:fix": "eslint . --fix && prettier --write . --log-level warn",
    "check": "turbo run typecheck build lint lint:root lint:prompt test test:root format:check knip jscpd layout",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "jscpd": "node scripts/jscpd.mjs",
    "workbook": "tsx --conditions=@sheavly/source apps/terminal/src/workbook/workbook.ts",
    "demo": "tsx --conditions=@sheavly/source apps/terminal/src/demo.ts",
    "lint:root": "eslint . --ignore-pattern 'packages/' --ignore-pattern 'extensions/' --ignore-pattern 'apps/'",
    "test:root": "vitest run",
    "check:affected": "turbo run typecheck build lint lint:root test test:root --affected && npm run check:repo",
    "check:typecheck": "turbo run typecheck build",
    "check:lint": "turbo run lint",
    "check:test": "turbo run test --filter=!@sheavly/eslint-config",
    "check:eslint-config": "turbo run test --filter=@sheavly/eslint-config",
    "check:root": "turbo run lint:root test:root",
    "check:repo": "turbo run lint:prompt format:check knip jscpd layout",
    "layout": "node scripts/check-layout.mjs",
    "new": "node scripts/new-workspace.mjs",
    "graph": "node scripts/graph.mjs",
    "export": "node scripts/export.mjs",
    "dev:terminal": "tsx --tsconfig apps/terminal/tsconfig.json --conditions=@sheavly/source apps/terminal/src/chat.ts",
    "theme:smoke": "tsx --conditions=@sheavly/source scripts/theme-smoke.mjs",
    "lint:prompt": "npm exec -w @sheavly/host -- eslint src/instructions/instructions.prompt.ts",
    "replay": "tsx --conditions=@sheavly/source apps/terminal/src/replay.ts",
    "sheavly": "tsx --tsconfig apps/sheavly/tsconfig.source.json --conditions=@sheavly/source apps/sheavly/src/cli.ts"
  },
  "type": "module",
  "devDependencies": {
    "@sheavly/eslint-config": "^0.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "extensions/*"
  ],
  "packageManager": "npm@12.2.1"
}
