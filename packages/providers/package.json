{
  "name": "@sheavly/providers",
  "version": "0.0.0",
  "description": "Model backends: the Responses and Messages protocols, their backends (OpenAI, Azure, Amazon Bedrock), the adapter registry and the provider switch. A UI builds its provider here.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "private": true,
  "sheavly": {
    "domain": "generic"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0",
    "@types/luxon": "^3.7.6",
    "luxon": "^3.7.2"
  },
  "exports": {
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.service": {
      "@sheavly/source": "./src/*.service.ts",
      "default": "./dist/*.service.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    },
    "./*.adapter": {
      "@sheavly/source": "./src/*.adapter.ts",
      "default": "./dist/*.adapter.js"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./chat-reply/*": null
  },
  "files": [
    "dist",
    "docs"
  ]
}
