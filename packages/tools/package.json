{
  "name": "@sheavly/tools",
  "version": "0.0.0",
  "description": "The generic tools a UI can include: sub-agents (start_agent, message_agent, report_status) and the background task tools. No files, no commands.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic",
    "appOnlyModules": [
      "web-search-backends"
    ]
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.1.0",
    "@sheavly/runtime": "^0.0.0",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "turndown": "^7.2.5",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0",
    "@types/turndown": "^5.0.6"
  },
  "exports": {
    "./*.tool": {
      "@sheavly/source": "./src/*.tool.ts",
      "default": "./dist/*.tool.js"
    },
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    }
  },
  "files": [
    "dist",
    "docs"
  ]
}
