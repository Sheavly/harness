{
  "name": "@sheavly/protocol",
  "version": "0.1.0",
  "description": "The wire contract: every event, update and answer the harness sends a UI or accepts from one, as zod schemas.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "schema": "tsx --conditions=@sheavly/source write-schema.mjs",
    "prepack": "npm run build"
  },
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "sheavly": {
    "domain": "generic"
  },
  "exports": {
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.validator": {
      "@sheavly/source": "./src/*.validator.ts",
      "default": "./dist/*.validator.js"
    },
    "./*.constants": {
      "@sheavly/source": "./src/*.constants.ts",
      "default": "./dist/*.constants.js"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "contract.schema.json",
    "openapi.json"
  ]
}
