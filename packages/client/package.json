{
  "name": "@sheavly/client",
  "version": "0.0.0",
  "description": "The harness's HTTP client for UIs: every route of the API (API_ROUTES), typed and parsed with the contract's schemas, and its SSE streams. Only apps depend on it.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic",
    "transport": true
  },
  "private": true,
  "exports": {
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "dependencies": {
    "@sheavly/protocol": "^0.1.0",
    "zod": "^4.6.7"
  }
}
