{
  "name": "@sheavly/core",
  "version": "0.0.0",
  "description": "The code contracts tools, hooks and providers are written against: defineTool, defineHook, defineAdapter, Provider and the Environment an app passes in.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "@sheavly/protocol": "^0.1.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "sheavly": {
    "domain": "generic"
  },
  "exports": {
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    },
    "./*.validator": {
      "@sheavly/source": "./src/*.validator.ts",
      "default": "./dist/*.validator.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "devDependencies": {
    "@types/luxon": "^3.7.6"
  }
}
