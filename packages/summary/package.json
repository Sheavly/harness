{
  "name": "@sheavly/summary",
  "version": "0.0.0",
  "description": "Built-in summarizers: rules-only sections and a model-based writer, written against the core Summarizer contract",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic"
  },
  "private": true,
  "exports": {
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.1.0"
  }
}
