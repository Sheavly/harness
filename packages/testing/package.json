{
  "name": "@sheavly/testing",
  "version": "0.0.0",
  "description": "Test fakes every workspace's tests share: scripted and routed providers, fake fetch, a tool runner. Tests and fakes only.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic",
    "testOnly": true
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.1.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "exports": {
    "./*.fake": {
      "@sheavly/source": "./src/*.fake.ts",
      "default": "./dist/*.fake.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    }
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6"
  }
}
