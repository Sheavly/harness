{
  "name": "@sheavly/host",
  "version": "0.0.0",
  "description": "The services one run shares: the session, task and approval registries around the provider a UI picked, and the run-service keys extensions read (runServices). No tools, hooks, settings or UI.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic"
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/extension": "^0.0.0",
    "@sheavly/loop": "^0.0.0",
    "@sheavly/protocol": "^0.1.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/tools": "^0.0.0"
  },
  "devDependencies": {
    "@sheavly/providers": "^0.0.0",
    "@sheavly/testing": "^0.0.0",
    "zod": "^4.6.7"
  },
  "exports": {
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.service": {
      "@sheavly/source": "./src/*.service.ts",
      "default": "./dist/*.service.js"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    },
    "./subscriptions/*": null
  },
  "files": [
    "dist",
    "docs"
  ]
}
