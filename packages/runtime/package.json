{
  "name": "@sheavly/runtime",
  "version": "0.0.0",
  "description": "The stateful services a run uses: sessions, background tasks and approvals. Nothing about files or code.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic"
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.1.0",
    "zod": "^4.6.7"
  },
  "exports": {
    "./*.constants": {
      "@sheavly/source": "./src/*.constants.ts",
      "default": "./dist/*.constants.js"
    },
    "./*.service": {
      "@sheavly/source": "./src/*.service.ts",
      "default": "./dist/*.service.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "devDependencies": {
    "@sheavly/testing": "^0.0.0"
  }
}
