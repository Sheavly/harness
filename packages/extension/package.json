{
  "name": "@sheavly/extension",
  "version": "0.0.0",
  "description": "The extension lifecycle: the Extension contract extensions are written against, and the host that activates them in dependency order, isolates failures, gates trust and merges what they contribute.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build",
    "schema": "tsx --conditions=@sheavly/source write-schema.mjs"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic"
  },
  "private": true,
  "exports": {
    "./*.service": {
      "@sheavly/source": "./src/*.service.ts",
      "default": "./dist/*.service.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.utils": {
      "@sheavly/source": "./src/*.utils.ts",
      "default": "./dist/*.utils.js"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./*.constants": {
      "@sheavly/source": "./src/*.constants.ts",
      "default": "./dist/*.constants.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    },
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "sheavly.schema.json"
  ],
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.1.0",
    "@sheavly/runtime": "^0.0.0",
    "zod": "^4.6.7"
  }
}
