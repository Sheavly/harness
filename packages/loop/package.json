{
  "name": "@sheavly/loop",
  "version": "0.0.0",
  "description": "The agent loop: streamAgent and runAgent, its events, the ordered queue, aborts and hooks. Nothing about files or which tools a run has.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic"
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.1.0",
    "@sheavly/runtime": "^0.0.0"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0",
    "@sheavly/tools": "^0.0.0",
    "zod": "^4.6.7"
  },
  "exports": {
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./hooks/*": null,
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ]
}
