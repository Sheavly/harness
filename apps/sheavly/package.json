    "@sheavly/client": "^0.0.0",
    "@sheavly/storage": "^0.0.0",
    "@sheavly/terminal": "^0.0.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "sheavly": "dist/cli.js"
  },
  "devDependencies": {
    "@sheavly/protocol": "^0.0.0"
