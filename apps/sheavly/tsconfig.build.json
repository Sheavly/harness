{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "customConditions": []
  },
  "references": [
    { "path": "../backend/tsconfig.build.json" },
    { "path": "../terminal/tsconfig.build.json" },
    { "path": "../../packages/client/tsconfig.build.json" },
    { "path": "../../packages/runtime/tsconfig.build.json" },
    { "path": "../../packages/storage/tsconfig.build.json" }
  ],
  "exclude": ["src/**/__tests__", "src/testing"]
}
