{
  "name": "@sheavly/terminal",
  "version": "0.0.0",
  "description": "The terminal front end: the demo (one prompt, printed as it happens) and the workbook (stored prompts, saved runs, step, diff and real-model checks).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "dev": "tsx --conditions=@sheavly/source src/chat.ts",
    "start": "npm run build && node dist/chat.js"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "coding"
  },
  "private": true,
  "dependencies": {
    "@earendil-works/pi-tui": "^1.5.0",
    "@sheavly/client": "^0.0.0",
    "@sheavly/coding": "^0.0.0",
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/storage": "^0.0.0",
    "@sheavly/workspace": "^0.0.0",
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0",
    "@types/luxon": "^3.7.6",
    "@types/react": "^19.3.0"
  },
  "exports": {
    "./chat/start.helper": {
      "@sheavly/source": "./src/chat/start.helper.ts",
      "default": "./dist/chat/start.helper.js"
    },
    "./chat/chat-failure.helper": {
      "@sheavly/source": "./src/chat/chat-failure.helper.ts",
      "default": "./dist/chat/chat-failure.helper.js"
    }
  }
}
